# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# Full Gmail address, e.g. you@gmail.com
GMAIL_USERNAME=

# A Google App Password (NOT your normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
GMAIL_PASSWORD=

# Where contact-form messages are delivered. Defaults to GMAIL_USERNAME if left blank.
CONTACT_RECEIVER=

# Port the API server listens on.
PORT=3001

# Google Gemini API key for the AI portfolio assistant.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-lite-latest if left blank.
GEMINI_MODEL=
